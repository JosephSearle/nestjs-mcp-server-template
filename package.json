{
	"name": "nestjs-mcp-server-template",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"description": "Template for production MCP servers on NestJS and @rekog/mcp-nest.",
	"engines": {
		"node": "^22.22.3 || >=24.15.0"
	},
	"scripts": {
		"build": "nest build",
		"start": "node --import ./dist/platform/telemetry/instrumentation.js dist/main.js",
		"dev": "nest start --watch --exec \"node --import ./dist/platform/telemetry/instrumentation.js\"",
		"dev:stdio": "nest start --watch --entryFile main.stdio",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
	},
	"dependencies": {
		"@modelcontextprotocol/core": "2.3.1",
		"@modelcontextprotocol/node": "2.1.1",
		"@modelcontextprotocol/server": "2.3.1",
		"@nestjs/common": "12.1.3",
		"@nestjs/config": "12.0.1",
		"@nestjs/core": "12.1.3",
		"@nestjs/microservices": "12.1.3",
		"@nestjs/platform-express": "12.1.3",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/core": "2.12.0",
		"@opentelemetry/exporter-metrics-otlp-grpc": "0.223.0",
		"@opentelemetry/exporter-metrics-otlp-proto": "0.223.0",
		"@opentelemetry/exporter-trace-otlp-grpc": "0.223.0",
		"@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
		"@opentelemetry/instrumentation": "0.223.0",
		"@opentelemetry/instrumentation-express": "0.71.0",
		"@opentelemetry/instrumentation-http": "0.223.0",
		"@opentelemetry/instrumentation-ioredis": "0.71.0",
		"@opentelemetry/resources": "2.12.0",
		"@opentelemetry/sdk-metrics": "2.12.0",
		"@opentelemetry/sdk-node": "0.223.0",
		"@opentelemetry/sdk-trace-base": "2.12.0",
		"@opentelemetry/semantic-conventions": "1.43.0",
		"@rekog/mcp-nest": "2.0.8",
		"nestjs-pino": "5.3.1",
		"pino": "10.4.0",
		"pino-http": "11.0.0",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@modelcontextprotocol/client": "2.3.1",
		"@nestjs/cli": "12.0.8",
		"@nestjs/testing": "12.1.3",
		"@opentelemetry/context-async-hooks": "2.12.0",
		"@types/express": "5.0.6",
		"@types/jest": "30.0.0",
		"@types/node": "26.6.5",
		"jest": "30.5.2",
		"ts-jest": "29.4.15",
		"typescript": "6.0.3"
	}
}
