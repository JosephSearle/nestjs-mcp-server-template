{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": [".claude/hooks/biome-check.mjs"],
						"timeout": 60,
						"statusMessage": "Running Biome check"
					}
				]
			}
		]
	}
}
