# Copy to .env for local development. Never commit .env or put real values in this file.
# Every variable is optional unless noted. Defaults are shown commented out.
# Empty values count as unset. Lists are comma-separated.
# OTEL_* variables are read by the OpenTelemetry SDK, which starts before .env is loaded. Set them
# in the real environment, not here. See the Telemetry section at the end.

# --- Server ---
# development, test or production. production disables AUTH_MODE=dev and the stdio entry.
# NODE_ENV=development
# PORT=3000

# --- MCP ---
# Default to name and version in package.json.
# MCP_SERVER_NAME=
# MCP_SERVER_VERSION=
# URL clients use to reach the server, without /mcp. Required in production.
# MCP_PUBLIC_URL=http://localhost:3000
# Origin and Host values to accept. Unset means not checked.
# MCP_ALLOWED_ORIGINS=
# MCP_ALLOWED_HOSTS=
# MCP_MAX_REQUEST_BYTES=1048576
# MCP_REQUEST_TIMEOUT_MS=60000
# MCP_INPUT_MAX_ROUNDS=5
# MCP_INPUT_ROUND_TIMEOUT_MS=300000
# At least 32 characters, the same on every replica. Required in production; random per process otherwise.
# MCP_REQUEST_STATE_SECRET=

# --- Auth ---
# external (an OAuth issuer) or dev (the built-in authorization server, local only).
# AUTH_MODE=external
# entra, auth0, keycloak or generic. Sets where scopes and roles are read from.
# AUTH_PROVIDER=generic
# Dotted claim paths that override the provider preset, for example realm_access.roles.
# AUTH_SCOPES_CLAIM=
# AUTH_ROLES_CLAIM=
# Required for the HTTP server when AUTH_MODE=external.
# AUTH_ISSUER=
# Defaults to MCP_PUBLIC_URL + /mcp.
# AUTH_AUDIENCE=
# Defaults to the issuer's discovery document.
# AUTH_JWKS_URI=
# RS256, RS384, RS512, PS256, PS384, PS512, ES256, ES384, ES512 or EdDSA.
# AUTH_ALGORITHMS=RS256
# Scopes every token must carry, for example mcp:access.
# AUTH_REQUIRED_SCOPES=
# AUTH_CLOCK_TOLERANCE_SECONDS=30
# AUTH_MAX_TOKEN_LIFETIME_SECONDS=5400

# --- Dev auth (AUTH_MODE=dev only) ---
# github or google.
# DEV_AUTH_PROVIDER=github
# OAuth app for local login. Required when AUTH_MODE=dev.
# DEV_AUTH_CLIENT_ID=
# DEV_AUTH_CLIENT_SECRET=
# At least 32 characters. Random per process when unset.
# DEV_AUTH_JWT_SECRET=

# --- Logging and operations ---
# fatal, error, warn, info, debug, trace or silent.
# LOG_LEVEL=info
# At least 32 characters, kept longer than telemetry retention. Required in production; random per process otherwise.
# LOG_PSEUDONYM_KEY=
# Proxies in front of the server whose X-Forwarded-* headers are trusted.
# TRUST_PROXY_HOPS=0
# Drain time on SIGTERM, below the platform's grace period.
# SHUTDOWN_TIMEOUT_MS=25000
# Only when the Redis state example is used. redis:// or rediss://.
# REDIS_URL=

# --- Telemetry (environment only; .env is read too late) ---
# Standard OpenTelemetry variables. Unset endpoint means nothing is exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# http/protobuf (port 4318) or grpc (port 4317).
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Defaults to MCP_SERVER_NAME, then the name in package.json.
# OTEL_SERVICE_NAME=
